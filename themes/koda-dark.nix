# See https://github.com/oskarnurm/koda.nvim/blob/main/LICENSE
# I used GLM-5.3-Flash to port over the kitty config
{
  scheme = "Koda Dark";
  author = "https://github.com/oskarnurm/koda.nvim";
  base00 = "#101010"; # background
  base01 = "#272727"; # lighter background (tab bar / statusline)
  base02 = "#272727"; # selection background
  base03 = "#666666"; # comments (color8)
  base04 = "#b0b0b0"; # dark foreground (cursor / selection fg)
  base05 = "#ffffff"; # default foreground
  base06 = "#ffffff"; # light foreground
  base07 = "#ffffff"; # lightest foreground
  base08 = "#ff5733"; # red (color1)
  base09 = "#ff7676"; # orange (color9)
  base0A = "#d9ba73"; # yellow (color3 / url)
  base0B = "#86cd82"; # green (color2)
  base0C = "#5abfb5"; # cyan (color6)
  base0D = "#a5adce"; # blue (color4)
  base0E = "#f2a4db"; # magenta (color5)
  base0F = "#f4b8e4"; # deprecated / tags (mark2 background)
}
